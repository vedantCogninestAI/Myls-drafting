PROJECT_NAME=AI Backend
VERSION=0.1.0
DEBUG=true

HOST=0.0.0.0
PORT=8000

CORS_ORIGINS=["http://localhost:3000"]

# AWS / Bedrock
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
BEDROCK_MODEL_ID=anthropic.claude-3-5-sonnet-20241022-v2:0

# Ingestion
INGESTION_CONCURRENCY=3
CLASSIFY_PDF_LLM=true

# Templates
TEMPLATE_CONCURRENCY=3

# Draft generation
MAX_DRAFT_REVISIONS=5

# USCIS fee/address scraping
FIRECRAWL_API_KEY=
OPENAI_KEY=
OPENAI_SCRAPING_MODEL=gpt-4o-mini

# Database
DATABASE_URL=

# Auth
SECRET_KEY=change-me-in-production

# Logging
LOG_LEVEL=INFO
LOG_FORMAT=json
